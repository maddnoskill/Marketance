# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais versionner .env.local.

# Supabase (phase 2) — URL et clé publique « anon », visibles par le navigateur
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — clé secrète, côté serveur uniquement (jamais de préfixe NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Fuseau horaire par défaut
DEFAULT_TIME_ZONE=America/Toronto
