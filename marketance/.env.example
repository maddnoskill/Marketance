# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais versionner .env.local.

# Supabase — URL et clé publique (« publishable »), visibles par le navigateur.
# Trouvables dans Supabase : Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site, utilisée dans les liens envoyés par courriel.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
